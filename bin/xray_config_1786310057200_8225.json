{
  "log": {
    "loglevel": "none"
  },
  "inbounds": [
    {
      "port": 18575,
      "listen": "127.0.0.1",
      "protocol": "socks",
      "settings": {
        "udp": true
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "Everyday-VPN.Telegram-Channel",
            "port": 443,
            "users": [
              {
                "id": "11111111-2222-1111-1111-111111111111",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "grpc",
        "security": "tls",
        "tlsSettings": {
          "serverName": "Everyday-VPN.Telegram-Channel",
          "allowInsecure": true
        },
        "grpcSettings": {
          "serviceName": ""
        }
      }
    },
    {
      "protocol": "freedom",
      "tag": "direct"
    }
  ]
}